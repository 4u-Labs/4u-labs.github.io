---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "title_en": {{ post.title_en | default: post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%d/%m/%Y" | jsonify }},
    "category": {{ post.categories.first | default: "Geral" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 180 | jsonify }},
    "excerpt_en": {{ post.excerpt_en | default: post.excerpt | strip_html | strip_newlines | truncate: 180 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
